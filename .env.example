# Copy to .env and fill in the channels you want. Unset channels are skipped.
# Never commit .env.

# --- Email (Gmail: create an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com,colleague@example.com

# --- Slack incoming webhook (optional) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Telegram bot (optional, good for phone alerts) ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# --- SEC EDGAR requires a contact in the User-Agent ---
SEC_USER_AGENT="MiningAlerts you@example.com"
